@inherits LayoutComponentBase

<MudThemeProvider @ref="ThemeProvider" @bind-IsDarkMode="IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h5" Class="ml-3">Passistant Meal Planner</MudText>
        <MudSpacer />
        <UserMenu />
    </MudAppBar>
    <MudMainContent Class="pt-16 px-4">
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
